# ─── Database (SQLite, no setup needed) ──────────────────────────────
# Note: the path is resolved relative to prisma/schema.prisma,
# so "../db/custom.db" points to "<project root>/db/custom.db".
DATABASE_URL="file:../db/custom.db"

# ─── LLM Provider (OpenAI-compatible API) ────────────────────────────
# Works with OpenAI, DeepSeek, Zhipu GLM, Moonshot, Ollama (local), etc.
# Any endpoint that implements /chat/completions is supported.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="sk-your-api-key-here"
LLM_MODEL="gpt-4o-mini"
